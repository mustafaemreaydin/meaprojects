# Veritabanı (SQLite, panel kökünden göreceli)
DATABASE_URL="file:./data/meaprojects.db"

# NextAuth (32+ karakter rastgele)
NEXTAUTH_SECRET="degistir-bunu-en-az-32-karakterlik-rastgele-bir-string"
NEXTAUTH_URL="http://localhost:3000"

# API anahtarları için AES-256 şifreleme anahtarı (tam 32 byte hex = 64 karakter)
SETTINGS_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# İlk kullanıcı (seed.ts bunlarla yaratır)
ADMIN_EMAIL="ben@meaprojects.local"
ADMIN_PASSWORD="degistir-beni"
ADMIN_NAME="Mustafa"

# Tool çalıştırma rate limit (dakikada çağrı)
LLM_RATE_LIMIT_PER_MIN="30"
